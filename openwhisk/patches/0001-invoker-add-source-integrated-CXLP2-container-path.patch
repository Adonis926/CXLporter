diff --git a/core/invoker/src/main/scala/org/apache/openwhisk/core/containerpool/cxlfork/CxlporterContainer.scala b/core/invoker/src/main/scala/org/apache/openwhisk/core/containerpool/cxlfork/CxlporterContainer.scala
